# Runtime environment
AMC_ENV=local

# Browser/backend connection
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_BASE_URL=http://localhost:8000

# Persistence: sqlite for local/CI, postgres for production
AMC_DATABASE_BACKEND=sqlite
AMC_DB_PATH=amc_local.db
DATABASE_URL=

# Workspace export root. Unset uses Zo Documents when writable, otherwise a temp directory.
AMC_EXPORT_ROOT=

# CORS
AMC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
AMC_AUTH_MODE=local
AMC_LOCAL_USER_ID=local-operator
AMC_LOCAL_TENANT_ID=tenant_1
AMC_LOCAL_PROJECT_IDS=proj_1
AMC_LOCAL_ROLE=operator
AMC_AUTH_TIMEOUT_SECONDS=5

# Approval authority. Only these membership roles may approve or reject, and
# the user who started a run may never approve it. AMC_ALLOW_SELF_APPROVAL is
# for single-user local development only; production configuration rejects it.
# To approve your own runs locally, set AMC_LOCAL_ROLE=admin and
# AMC_ALLOW_SELF_APPROVAL=true.
AMC_APPROVER_ROLES=reviewer,approver,admin,owner
AMC_ALLOW_SELF_APPROVAL=

# Cost and rate limits (0 disables a run limit explicitly).
AMC_LLM_TIMEOUT_SECONDS=45
AMC_LLM_MAX_OUTPUT_TOKENS=2000
AMC_MAX_TOKENS_PER_RUN=60000
AMC_MAX_RUNS_PER_TENANT_PER_HOUR=60
AMC_MAX_ACTIVE_RUNS_PER_TENANT=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Agency model provider (docs/amc-i03-model-profiles.md). A new run pins the
# selection; later config changes do not switch a running run. Without a usable
# credential, generation is explicitly DEGRADED and delivery is blocked.
# AMC_LLM_PROVIDER: openai (default) | anthropic | gemini | ollama
AMC_LLM_PROVIDER=
# Comma-separated fallback providers. Empty = no fallback (the default).
AMC_LLM_FALLBACK_PROVIDERS=
# Providers to refuse right now, even for runs that already pinned them.
AMC_LLM_DISABLED_PROVIDERS=
OPENAI_API_KEY=
AMC_OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
AMC_ANTHROPIC_MODEL=
# Gemini Developer API. GOOGLE_API_KEY is read before GEMINI_API_KEY, as in the
# google-genai SDK. No default model: set AMC_GEMINI_MODEL explicitly.
GEMINI_API_KEY=
AMC_GEMINI_MODEL=
AMC_OLLAMA_MODEL=

# External mutation controls: fail closed by default
AMC_PUBLICATION_MODE=disabled
AMC_PAID_MEDIA_MODE=disabled
# Delivery contracts (docs/unified-delivery.md): off = legacy graph and release
# path; shadow = evaluate contracts and record release verdicts only; enforce =
# require a contract and block release on the release predicate. Changing it
# affects new runs only; paused runs resume with the mode they were created in.
AMC_CONTRACT_MODE=off

# zo.computer integration: fail closed by default. ZO_API_KEY is a secret;
# never commit a real value.
AMC_ZO_MODE=disabled
ZO_API_KEY=

# Logging (optional). Levels: debug, info, warn, error ("warning" = warn).
# Unset leaves the host's logging configuration untouched.
AMC_LOG_LEVEL=
NEXT_PUBLIC_LOG_LEVEL=info

# Optional observability integrations
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
DEEPEVAL_API_KEY=
PHOENIX_ENDPOINT=

# --- Project OS ---------------------------------------------------------------
# Object storage for media and large artifacts. Only "local" (content-addressed
# under AMC_EXPORT_ROOT/projects/...) is implemented; "r2" fails closed and is
# rejected by production configuration until a reviewed adapter exists.
AMC_OBJECT_STORAGE_BACKEND=local
# Presence-only R2 binding description (never echoed): AMC_R2_BUCKET, AMC_R2_ACCOUNT_ID,
# AMC_R2_ACCESS_KEY_ID, AMC_R2_SECRET_ACCESS_KEY. Leave unset.
# Directory FreeVideoForge writes runs into; video ingest refuses paths outside it.
# Defaults to $AMC_EXPORT_ROOT/freevideoforge.
AMC_VIDEO_INGEST_ROOT=
# Service-level objectives exist only after a measured baseline, e.g.
# AMC_SLO_SCHEDULER_SCHEDULER_DELAY_SECONDS=60. Unset = GAP_NO_BASELINE.

# --- Website production line (/ucpo, docs/ucpo/README.md) -----------------------
# Where Playwright's Chromium lives, passed into the sandboxed browser QA. Unset uses
# /opt/pw-browsers when present, otherwise ~/.cache/ms-playwright when it exists.
PLAYWRIGHT_BROWSERS_PATH=

# --- Mission Council (/missions, docs/mission-council.md) -----------------------
# Council seats (George, Fable/Cipher, Arty) run on a deterministic mock model
# unless real models are enabled explicitly. With ENABLE_REAL_MODELS=true the
# seats use DEFAULT_MODEL_PROVIDER (openai | anthropic | gemini | ollama) through
# the canonical model router; a missing credential fails the seat, never mocks it.
ENABLE_REAL_MODELS=false
DEFAULT_MODEL_PROVIDER=mock
# inline: run the engine inside the request (tests); thread: bounded worker pool.
COUNCIL_EXECUTION=thread
COUNCIL_MAX_CONCURRENT_MISSIONS=4
# Per-seat wall-clock timeout and attempts (timeouts and invalid output are retried).
COUNCIL_SEAT_TIMEOUT_SECONDS=60
COUNCIL_SEAT_MAX_ATTEMPTS=2
# A mission lease older than this can be recovered from its last checkpoint.
COUNCIL_LEASE_SECONDS=300
# Recover missions whose lease expired (e.g. after a crash) when the API starts.
COUNCIL_RECOVER_ON_STARTUP=false
# Allowlisted MCP stdio servers as JSON; empty = none. Each entry needs an
# absolute command and an explicit tool allowlist; see docs/mission-council.md.
AMC_MCP_SERVERS=


# ---------------------------------------------------------------------------
# Additional runtime variables read by the code (M0, G-03). Every value is
# blank on purpose: an empty value means the feature stays off or uses its
# documented default. Secrets belong in the platform's secret store, never in
# a committed file.
# ---------------------------------------------------------------------------

# Governed actions (ACE v12). Freeze blocks every dispatch; set only in an incident.
AMC_ACTIONS_FREEZE=
# Deliberately ignored. Setting it has no effect and is reported as such; never set it.
AMC_ACTIONS_LIVE=

# Build identity reported by /version (null when unset, never invented).
AMC_BUILD_COMMIT_SHA=
AMC_BUILD_TIMESTAMP=

# Signs delivered deliverables with HMAC-SHA256 when at least 32 characters (SECRET).
# Unset: deliverables are UNSIGNED and say so.
AMC_DELIVERY_SIGNING_KEY=

# Inbound HMAC ingress for /runtime/ingest. The secret is SECRET; the header name
# defaults to X-AMC-Signature.
AMC_HMAC_SECRET=
AMC_HMAC_HEADER=

# Maximum queued items for the in-process runtime queue (default 128). Per process only.
AMC_MVP_QUEUE_MAXSIZE=

# Set to "enabled" to export OpenTelemetry spans. Off by default; nothing is exported otherwise.
AMC_OTEL_EXPORT=

# Cloudflare R2 storage binding (fails closed until a reviewed client exists). Keys are SECRET.
AMC_R2_ACCOUNT_ID=
AMC_R2_BUCKET=
AMC_R2_ACCESS_KEY_ID=
AMC_R2_SECRET_ACCESS_KEY=

# VNEXUS simulated providers. Only honoured when AMC_VNEXUS_MOCK_PROVIDERS=1 and the
# environment is not production; their output is never claimable as generated.
AMC_VNEXUS_MOCK_PROVIDERS=
AMC_VNEXUS_MOCK_COST_MINOR=
AMC_VNEXUS_MOCK_RATE_LIMIT=

# Release-evidence collector (scripts/collect_release_evidence.py). The token is SECRET
# and needs read access to check runs; the repository defaults to this project.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Set by Vercel at build time; used as a fallback commit identity for /version.
VERCEL_GIT_COMMIT_SHA=

# Project export to Google Drive + Notion (scripts/export_to_drive.py, docs/drive-export.md).
# RUNNER_MODE: dry_run (default: build the zip locally, no network) | local | ci (upload).
RUNNER_MODE=
AMC_PROJECT_PATH=
# Google credential: use ONE of the two options below, never both.
# A) Service account (Google Workspace shared drive): key JSON or a path to it. SECRET.
#    The folder must be in a shared drive (service accounts have no storage quota) and be
#    shared with the account; DRIVE_PARENT_FOLDER_ID is required.
GOOGLE_SA_JSON=
DRIVE_PARENT_FOLDER_ID=
# B) Signed-in user (personal Google account): an OAuth Desktop-app client plus the refresh
#    token printed by scripts/drive_authorize.py. All three are SECRET. DRIVE_PARENT_FOLDER_ID
#    stays empty; the runner creates "AMC exports" in My Drive.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: Workspace user to impersonate through domain-wide delegation.
GOOGLE_IMPERSONATE_SUBJECT=
# "true" shares each export with anyone who has the link. Default false.
UPLOAD_PUBLIC=
REPO_COMMIT_SHA=
# Notion internal integration token. SECRET. Set a database id (preferred) or a parent page id.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=
# Optional base64 AES-256 key (32 bytes) to encrypt exports before upload. SECRET.
EXPORT_ENCRYPTION_KEY=
# Optional: keep this many most recent full exports and trash anything older.
EXPORT_RETENTION_FULL_KEEP=
# Set by GitHub Actions; recorded as the export actor (falls back to the OS user).
GITHUB_ACTOR=
