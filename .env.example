# Runtime environment
AMC_ENV=local

# Browser/backend connection
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_BASE_URL=http://localhost:8000

# Persistence: sqlite for local/CI, postgres for production
AMC_DATABASE_BACKEND=sqlite
AMC_DB_PATH=amc_local.db
DATABASE_URL=

# Workspace export root. Unset uses Zo Documents when writable, otherwise a temp directory.
AMC_EXPORT_ROOT=

# CORS
AMC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
AMC_AUTH_MODE=local
AMC_LOCAL_USER_ID=local-operator
AMC_LOCAL_TENANT_ID=tenant_1
AMC_LOCAL_PROJECT_IDS=proj_1
AMC_LOCAL_ROLE=operator
AMC_AUTH_TIMEOUT_SECONDS=5

# Approval authority. Only these membership roles may approve or reject, and
# the user who started a run may never approve it. AMC_ALLOW_SELF_APPROVAL is
# for single-user local development only; production configuration rejects it.
# To approve your own runs locally, set AMC_LOCAL_ROLE=admin and
# AMC_ALLOW_SELF_APPROVAL=true.
AMC_APPROVER_ROLES=reviewer,approver,admin,owner
AMC_ALLOW_SELF_APPROVAL=

# Cost and rate limits (0 disables a run limit explicitly).
AMC_LLM_TIMEOUT_SECONDS=45
AMC_LLM_MAX_OUTPUT_TOKENS=2000
AMC_MAX_TOKENS_PER_RUN=60000
AMC_MAX_RUNS_PER_TENANT_PER_HOUR=60
AMC_MAX_ACTIVE_RUNS_PER_TENANT=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Agency model provider. If unset, generation is explicitly DEGRADED.
OPENAI_API_KEY=
AMC_OPENAI_MODEL=gpt-4o-mini

# External mutation controls: fail closed by default
AMC_PUBLICATION_MODE=disabled
AMC_PAID_MEDIA_MODE=disabled

# zo.computer integration: fail closed by default. ZO_API_KEY is a secret;
# never commit a real value.
AMC_ZO_MODE=disabled
ZO_API_KEY=

# Optional observability integrations
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
DEEPEVAL_API_KEY=
PHOENIX_ENDPOINT=

# --- Project OS ---------------------------------------------------------------
# Object storage for media and large artifacts. Only "local" (content-addressed
# under AMC_EXPORT_ROOT/projects/...) is implemented; "r2" fails closed and is
# rejected by production configuration until a reviewed adapter exists.
AMC_OBJECT_STORAGE_BACKEND=local
# Presence-only R2 binding description (never echoed): AMC_R2_BUCKET, AMC_R2_ACCOUNT_ID,
# AMC_R2_ACCESS_KEY_ID, AMC_R2_SECRET_ACCESS_KEY. Leave unset.
# Directory FreeVideoForge writes runs into; video ingest refuses paths outside it.
# Defaults to $AMC_EXPORT_ROOT/freevideoforge.
AMC_VIDEO_INGEST_ROOT=
# Service-level objectives exist only after a measured baseline, e.g.
# AMC_SLO_SCHEDULER_SCHEDULER_DELAY_SECONDS=60. Unset = GAP_NO_BASELINE.

