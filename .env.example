# Browser/backend connection
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_BASE_URL=http://localhost:8000

# Local persistence
AMC_DB_PATH=amc_local.db
DATABASE_URL=

# CORS
AMC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
# ONLY use AMC_AUTH_MODE=local for loopback development. External deployment
# must integrate a verified authentication provider before changing this mode.
AMC_AUTH_MODE=local
AMC_LOCAL_USER_ID=local-operator
AMC_LOCAL_TENANT_ID=tenant_1
AMC_LOCAL_PROJECT_IDS=proj_1
AMC_LOCAL_ROLE=operator

# Agency model provider. If unset, generation is explicitly DEGRADED and
# delivery is blocked; fallback content is never treated as provider success.
OPENAI_API_KEY=
AMC_OPENAI_MODEL=gpt-4o-mini

# Optional observability/provider integrations (not required for local MVP)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
DEEPEVAL_API_KEY=
PHOENIX_ENDPOINT=

# Planned/deferred infrastructure bindings
SUPABASE_URL=
SUPABASE_ANON_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=
KV_NAMESPACE=
WORKER_ENV=
