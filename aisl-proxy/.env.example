# AISL proxy gateway configuration.
# Copy to .env and fill in. Every value is validated at boot; a malformed one
# fails startup rather than surfacing mid-payment.

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080
# Used to build order_status_url in checkout responses.
PUBLIC_BASE_URL=http://localhost:8080

# ---- Persistence ---------------------------------------------------------
DATABASE_URL=postgresql://aisl:aisl@localhost:5432/aisl_db
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=aisl

# ---- Payments ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared payment tokens are served by a preview API version.
# https://docs.stripe.com/agentic-commerce/concepts/shared-payment-tokens
STRIPE_API_VERSION=2026-04-22.preview

# ---- Secrets -------------------------------------------------------------
# HMAC salt binding click_id -> (agent, merchant). Min 32 chars.
#   openssl rand -hex 32
AISL_ATTRIBUTION_SALT=
# base64-encoded 32-byte AES-256-GCM key for merchant credentials at rest.
#   openssl rand -base64 32
AISL_CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated bearer keys accepted on /v1/agent/*. Required in production.
AISL_AGENT_API_KEYS=
AISL_REQUIRE_AGENT_AUTH=true

# ---- Protocol behaviour --------------------------------------------------
# Attribution window for a minted acp_token (blueprint: 24h).
ACP_TOKEN_TTL_SECONDS=86400
# 0 disables the catalogue cache and always hits the merchant API.
CATALOG_CACHE_TTL_SECONDS=60
# Webhook dedupe retention (blueprint: 7 days).
WEBHOOK_DEDUPE_TTL_SECONDS=604800

# ---- Rate limiting (token bucket, per agent API key) ---------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=2

# ---- Outbound ------------------------------------------------------------
CONNECTOR_TIMEOUT_MS=8000
