  "detail": {
    "sop": {
      "sop_id": "F04",
      "name": "Competitive Identity Audit",
      "department_id": "D01",
      "department_name": "BRAND INTELLIGENCE",
      "batch": "BATCH_1",
      "procedure_status": "NEWLY_AUTHORED_DRAFT",
      "origin": "NEWLY_AUTHORED_SOP",
      "draft_version": "0.1-draft",
      "source_sha256": "6969b7a70e0a9e7a260e8e33d802e51cd9d3932e01b0ad005ccfe8b6829d921a",
      "step_count": 7
    },
    "steps": [
      {
        "step_ref": "F04.S1",
        "sequence": 1,
        "line": 16,
        "text": "Define the comparison frame and select competitors using a stated rule (for example, customer alternatives or category search visibility). Include substitutes where relevant.",
        "agm_disposition": "PARTIAL_MATCH",
        "agm_task_ids": [
          "AGM-04-001",
          "AGM-04-002"
        ]
      },
      {
        "step_ref": "F04.S2",
        "sequence": 2,
        "line": 17,
        "text": "Gather current, public primary materials: official websites, product pages, pricing, packaging, public campaigns, and public company statements. Record URL, capture date, market, and access limitations.",
        "agm_disposition": "PARTIAL_MATCH",
        "agm_task_ids": [
          "AGM-04-003",
          "AGM-04-006"
        ]
      },
      {
        "step_ref": "F04.S3",
        "sequence": 3,
        "line": 18,
        "text": "Record observable identity dimensions: stated promise, audience, category language, proof, offer, price cues, tone, visual codes, channels, and calls to action. Distinguish quoted claims from analyst interpretation.",
        "agm_disposition": "PARTIAL_MATCH",
        "agm_task_ids": [
          "AGM-04-004",
          "AGM-04-005"
        ]
      },
      {
        "step_ref": "F04.S4",
        "sequence": 4,
        "line": 19,
        "text": "Cross-check material claims across more than one primary artifact where possible. Label inaccessible, stale, or promotional claims as such.",
        "agm_disposition": "PARTIAL_MATCH",
        "agm_task_ids": [
          "AGM-04-005"
        ]
      },
      {
        "step_ref": "F04.S5",
        "sequence": 5,
        "line": 20,
        "text": "Compare patterns in a matrix. Mark common conventions, distinct positions, and apparent gaps; do not infer customer preference from competitor messaging alone.",
        "agm_disposition": "PARTIAL_MATCH",
        "agm_task_ids": [
          "AGM-04-012"
        ]
      },
      {
        "step_ref": "F04.S6",
        "sequence": 6,
        "line": 21,
        "text": "Identify potential conflicts, trademark/name risks, regulated claims, and copied expression for qualified legal review; do not make a legal conclusion.",
        "agm_disposition": "PARTIAL_MATCH",
        "agm_task_ids": [
          "AGM-24-009",
          "AGM-24-004"
        ]
      },
      {
        "step_ref": "F04.S7",
        "sequence": 7,
        "line": 22,
        "text": "Test proposed whitespace against customer evidence (F03), category evidence (F05), and confidence (F06). Record disconfirming examples.",
        "agm_disposition": "PARTIAL_MATCH",
        "agm_task_ids": [
          "AGM-04-013",
          "AGM-04-011"
        ]
      }
    ],
