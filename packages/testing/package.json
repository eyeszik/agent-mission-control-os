{
  "name": "@amc/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Test helpers: contexts, mock responses and Vitest hooks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@amc/config": "workspace:*",
    "@amc/constants": "workspace:*",
    "@amc/logger": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
